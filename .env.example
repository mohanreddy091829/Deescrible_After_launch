# Public URL of the deployed site (used for canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Admin (required to unlock /admin; password 10+ characters) ---
ADMIN_PASSWORD=choose-a-long-password-12-plus-characters
SESSION_SECRET=at-least-32-random-characters

# --- Storage on Vercel: create a Blob store in the project, Vercel adds this automatically ---
# BLOB_READ_WRITE_TOKEN=

# --- Enquiry form delivery (all optional) ---
# Gmail: use a Google "App password" (Google account > Security > 2-Step Verification > App passwords)
# GMAIL_USER=dedeepyajprwork@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# NOTIFY_EMAIL=dedeepyajprwork@gmail.com
# WhatsApp alert to the owner's own number via the free CallMeBot service (send it the activation message once)
# CALLMEBOT_PHONE=91XXXXXXXXXX
# CALLMEBOT_APIKEY=
# Number visitors can continue the chat with after submitting (digits, with country code)
# WHATSAPP_NUMBER=91XXXXXXXXXX

# --- Demo deployments: stop Google indexing the demo (leave unset / true on the real site) ---
# NEXT_PUBLIC_ALLOW_INDEXING=false
# --- WhatsApp click-to-chat number (digits with country code) ---
# NEXT_PUBLIC_WHATSAPP_NUMBER=919XXXXXXXXX
