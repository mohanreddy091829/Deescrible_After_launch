# Copy to .env.local (local) or .env.production (server). NEVER commit real values.

# Public address of the site (canonical links, sitemap, share previews)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Session signing (required): 32+ random characters, e.g.  openssl rand -hex 32
SESSION_SECRET=

# --- Supabase (production storage + admin login) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# The one account allowed into /admin. Create it in Supabase > Authentication > Users.
ADMIN_EMAIL=you@example.com

# --- Local development only, when Supabase is not configured: a single shared admin password (10+ characters)
# ADMIN_PASSWORD=

# --- Enquiry email via Gmail "App password" (optional) ---
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# NOTIFY_EMAIL=

# --- Demo deployments: stop Google indexing the demo (leave unset on the real site) ---
# NEXT_PUBLIC_ALLOW_INDEXING=false
